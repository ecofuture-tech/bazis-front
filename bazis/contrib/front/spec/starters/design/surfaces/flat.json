{
  "$schema": "../../../schemas/tokens.schema.json",
  "$description": "Almost no shadows: the surfaces are told apart by their borders and colors; the popovers and the dialogs keep a light one.",
  "shadow": {
    "xs": {"$type": "shadow", "$value": "0 0 #0000"},
    "sm": {"$type": "shadow", "$value": "0 0 #0000"},
    "md": {"$type": "shadow", "$value": "0 1px 2px color-mix(in srgb, var(--foreground) 6%, transparent)"},
    "lg": {"$type": "shadow", "$value": "0 4px 12px -4px color-mix(in srgb, var(--foreground) 12%, transparent)"}
  },
  "dark": {
    "shadow": {
      "xs": {"$type": "shadow", "$value": "0 0 #0000"},
      "sm": {"$type": "shadow", "$value": "0 0 #0000"},
      "md": {"$type": "shadow", "$value": "0 1px 2px rgb(0 0 0 / 0.3)"},
      "lg": {"$type": "shadow", "$value": "0 4px 12px -4px rgb(0 0 0 / 0.5)"}
    }
  }
}
