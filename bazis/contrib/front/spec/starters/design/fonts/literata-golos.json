{
  "$schema": "../../../schemas/tokens.schema.json",
  "$description": "Golos Text for the text, Literata with its optical sizes for the headings and the figures: warm and calm, for retail, travel and hospitality. Served by the frontend itself (OFL), with fallback faces of the same metrics.",
  "font": {
    "body": {"$type": "fontFamily", "$value": ["Golos Text", "Golos Text Fallback", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Arial", "sans-serif"], "$extensions": {"bazis": {"font": {"starter": "golos-text"}}}},
    "heading": {"$type": "fontFamily", "$value": ["Literata", "Literata Fallback", "ui-serif", "Georgia", "serif"], "$extensions": {"bazis": {"font": {"starter": "literata"}}}},
    "weight-heading": {"$type": "fontWeight", "$value": 500},
    "weight-subheading": {"$type": "fontWeight", "$value": 600},
    "tracking-heading": {"$type": "dimension", "$value": "-0.015em"}
  }
}
