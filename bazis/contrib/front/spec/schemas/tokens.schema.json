{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bazis-front:spec:tokens:1",
  "title": "spec/design/tokens.json: design tokens (a subset of the DTCG format)",
  "description": "Groups of tokens; a token has `$value` and `$type` (color, dimension, fontFamily, fontWeight, number, duration, shadow, cubicBezier). A value may reference another token as `{group.token}`. The type of a token is not inherited from its group. A fontFamily token may give the CSS import of its font: `$extensions: {bazis: {import: <an npm package of the font, or the https URL of a stylesheet>}}`.",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "$description": {"type": "string"}
  },
  "patternProperties": {
    "^[^$.{}][^.{}]*$": {"$ref": "#/$defs/node"}
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "if": {"type": "object", "anyOf": [{"required": ["$value"]}, {"required": ["$type"]}]},
      "then": {"$ref": "#/$defs/token"},
      "else": {"$ref": "#/$defs/group"}
    },
    "group": {
      "type": "object",
      "properties": {"$description": {"type": "string"}},
      "patternProperties": {"^[^$.{}][^.{}]*$": {"$ref": "#/$defs/node"}},
      "additionalProperties": false
    },
    "alias": {"type": "string", "pattern": "^\\{[^{}.$][^{}$]*\\}$"},
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$value", "$type"],
      "properties": {
        "$value": true,
        "$type": {"enum": ["color", "dimension", "fontFamily", "fontWeight", "number", "duration", "shadow", "cubicBezier"]},
        "$description": {"type": "string"},
        "$extensions": {
          "type": "object",
          "properties": {
            "bazis": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "import": {"type": "string", "pattern": "^(https://[^'\"()\\s]+|@?[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*)$"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"$type": {"const": "color"}}},
          "then": {"properties": {"$value": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"$type": {"const": "dimension"}}},
          "then": {"properties": {"$value": {"type": "string", "pattern": "^(\\{[^{}.$][^{}$]*\\}|-?[0-9]+(\\.[0-9]+)?(px|rem|em))$"}}}
        },
        {
          "if": {"properties": {"$type": {"const": "fontFamily"}}},
          "then": {"properties": {"$value": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}]}}}
        },
        {
          "if": {"properties": {"$type": {"const": "fontWeight"}}},
          "then": {"properties": {"$value": {"anyOf": [{"$ref": "#/$defs/alias"}, {"type": "integer", "minimum": 1, "maximum": 1000}]}}}
        },
        {
          "if": {"properties": {"$type": {"const": "number"}}},
          "then": {"properties": {"$value": {"anyOf": [{"$ref": "#/$defs/alias"}, {"type": "number"}]}}}
        },
        {
          "if": {"properties": {"$type": {"const": "duration"}}},
          "then": {"properties": {"$value": {"type": "string", "pattern": "^(\\{[^{}.$][^{}$]*\\}|[0-9]+(\\.[0-9]+)?ms)$"}}}
        },
        {
          "if": {"properties": {"$type": {"const": "shadow"}}},
          "then": {"properties": {"$value": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"$type": {"const": "cubicBezier"}}},
          "then": {"properties": {"$value": {"type": "string", "pattern": "^(\\{[^{}.$][^{}$]*\\}|cubic-bezier\\(\\s*-?[0-9.]+(\\s*,\\s*-?[0-9.]+){3}\\s*\\)|linear|ease|ease-in|ease-out|ease-in-out)$"}}}
        }
      ]
    }
  }
}
